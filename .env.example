# ============================================================
# Frontend Environment Variables Template
# ============================================================

# Backend API base URL
VITE_API_URL=http://localhost:3000/api/v1

# App Configuration
VITE_APP_NAME="Velora Child Safety Management System"
VITE_APP_VERSION="1.0.0"

# Gemini AI API Key
VITE_GEMINI_API_KEY=

# ============================================================
# Public Staff Access Portal Base URL (Required for RFID live links)
# ============================================================
# For local dual-port testing: http://localhost:5174
# For live Cloudflare Tunnel / public deployment: https://your-staff-portal.trycloudflare.com
VITE_STAFF_PORTAL_URL=http://localhost:5174
